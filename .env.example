PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa
# Origens do frontend autorizadas a enviar alterações; separe por vírgula.
APP_ORIGINS=http://localhost:3000,https://seu-site.netlify.app
# Envio dos códigos de confirmação de e-mail empresarial (Gmail)
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=
# Neon Object Storage (compatível com S3)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Ative somente para testes locais; exige NODE_ENV=development
COMPANY_CNPJ_TEST_MODE=false
