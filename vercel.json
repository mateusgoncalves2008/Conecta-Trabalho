{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://conecta-trabalho.onrender.com/api/:path*"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/frontend/manifest.webmanifest"
    },
    {
      "source": "/service-worker.js",
      "destination": "/frontend/service-worker.js"
    },
    {
      "source": "/offline.html",
      "destination": "/frontend/offline.html"
    },
    {
      "source": "/img/:path*",
      "destination": "/frontend/img/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/pages/:path*",
      "destination": "/frontend/pages/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
