{
  "rewrites": [\n    { "source": "/img/:path*", "destination": "/frontend/img/:path*" },
    {
      "source": "/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/pages/:path*",
      "destination": "/frontend/pages/:path*"
    }
  ]
}
